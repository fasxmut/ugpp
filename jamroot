constant name : ugpp ;

path-constant prj-dir : . ;

#################################################################

rule help ( )
{
	if ! [ MATCH ^(help)$ : [ modules.peek : ARGV ] ]
	{
		return ;
	}

	# else

	echo "b2 [build options]" ;
	echo "	Get [build options]: b2 --help" ;
	echo "	Examples:" ;
	echo "		b2 -q -j7" ;
	echo "		b2 -q -j7 -a" ;
	echo "b2 install --prefix=/sand" ;
	echo "b2 cleanall" ;

	exit ;
}

help ;

#################################################################

rule cleanall ( path )
{
	if ! [ MATCH ^(cleanall)$ : [ modules.peek : ARGV ] ]
	{
		return ;
	}

	# else

	echo "cleanall ..." ;

	local cmd = "rm -rf `find $(path) -name bin`" ;

	echo $(cmd) ;
	SHELL $(cmd) ;

	exit ;
}

cleanall $(prj-dir) ;

#################################################################

constant version.major : 0 ;
constant version.minor : 0 ;
constant version.patch : 0 ;
constant version : $(version.major).$(version.minor).$(version.patch) ;

#################################################################

rule show-build ( name : mark )
{
	echo "$(mark) Building $(name) ..." ;
}

#################################################################

show-build $(name) : >>> ;

#################################################################

rule get-prefix ( )
{
	local prefix = [ option.get prefix ] ;

	if ! $(prefix)
	{
		if [ MATCH ^(--prefix) : [ modules.peek : ARGV ] ]
		{
			echo "ERROR:" ;
			echo "Format: --prefix=value , and empty value is not allowed!" ;
			exit ;
		}
		else
		{
			prefix = /usr/local ;
		}
	}

	if ! [ MATCH ^(/) : $(prefix) ]
	{
		echo "ERROR: prefix must be an absolute path !" ;
		exit ;
	}

	if [ MATCH ^(\[/.\]+)$ : $(prefix) ]
	{
		echo "ERROR: prefix error: root path is not allowed." ;
		exit ;
	}

	return $(prefix) ;
}

constant prefix : [ get-prefix ] ;

#################################################################

project
:
	requirements
		<cxxstd>26
;

build-project sources ;

alias install : ./sources//install ;
explicit install ;

# Export library
alias ugpp : ./sources//ugpp ;

