constant name : ugpp ;
path-constant prj-root : . ;

import ./common/ugpp-name.jam : ugpp-name ;
project
	[ ugpp-name $(name) ]
;

###############################################################
# cleanall

if [ MATCH ^(cleanall) : [ modules.peek : ARGV ] ]
{
	local cmd = "rm -rf `find $(prj-root) -name bin`" ;
	echo $(cmd) ;
	SHELL $(cmd) ;
	exit ;
}

###############################################################

build-project sources ;

###############################################################
# For library sources

#------- prefix ----------------------

rule get-prefix ( )
{
	local prefix = [ option.get prefix ] ;

	if ! $(prefix)
	{
		return /usr/local ;
	}

	if ! [ MATCH ^(/) : $(prefix) ]
	{
		echo "ERROR: prefix should not be a relative path!" ;
		exit ;
	}

	if [ MATCH ^(/+)$ : $(prefix) ]
	{
		echo "ERROR: / is not allowed to be used as a prefix !" ;
		exit ;
	}

	return $(prefix) ;
}

path-constant prefix : [ get-prefix ] ;

echo "Set prefix: $(prefix)" ;

#------- install ----------------------

alias
	install
:
	./sources//install
;
explicit install ;

#------- Export ----------------------

alias ugpp : ./sources//ugpp ;

