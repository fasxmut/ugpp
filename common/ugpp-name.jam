class ugpp-name-def
{
	rule __init__ ( name )
	{
		self.name = $(name) ;
		echo ">>>>> Building $(self.name) ..." ;
	}

	rule name ( )
	{
		return $(self.name) ;
	}
}

rule ugpp-name ( name )
{
	import "class" : new ;
	local obj = [ new ugpp-name-def $(name) ] ;
	return [ $(obj).name ] ;
}

