class ugpp-version
{
	rule __init__ ( )
	{
		self.__major = 0 ;
		self.__minor = 0 ;
		self.__patch = 0 ;
	}

	rule major ( )
	{
		return $(self.__major) ;
	}

	rule minor ( )
	{
		return $(self.__minor) ;
	}

	rule patch ( )
	{
		return $(self.__patch) ;
	}

	rule get ( )
	{
		return $(self.__major).$(self.__minor).$(self.__patch) ;
	}
}

