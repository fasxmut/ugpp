import ../../common/ugpp-version.jam ;
import "class" : new ;
local vs_obj = [ new ugpp-version ] ;
local version = [ $(vs_obj).get ] ;
echo $(version) ;

lib
	ugpp
:
	ugpp.cpp
:
	<version>$(version)
	<tag>@make-version
;

import common ;

rule make-version ( name : type ? : props )
{
	local name = [ common.format-name <base> : $(name) : $(type) : $(props) ] ;
	local version = [ $(props).get <version> ] ;
	return $(name).$(version) ;
}

