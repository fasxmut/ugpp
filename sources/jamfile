constant name : $(name)/sources ;

import ../common/ugpp-name.jam : ugpp-name ;

path-constant src-inc-dir : ./hpp ;
constant
	src-headers
:
	ugpp/basic_tuple_map.hpp
	ugpp/basic_vector_tuple_map.hpp
	ugpp/vector_tumap.hpp
	ugpp/basic_list_tuple_map.hpp
	ugpp/list_tumap.hpp
;

project
	[ ugpp-name $(name) ]
:
	default-build
		<cxxstd>26
:
	requirements
		<include>$(src-inc-dir)
;

build-project cpp ;
build-project examples ;

#################################################################
# Install

install
	install-headers
:
	$(src-inc-dir)/$(src-headers)
:
	<location>$(prefix)/include
	<install-source-root>$(src-inc-dir)/
;
explicit install-headers ;

install
	install-libs
:
	./cpp//ugpp
:
	<location>$(prefix)/lib
;
explicit install-libs ;

install
	install-share-files
:
	$(prj-root)/LICENSE_1_0.txt
:
	<location>$(prefix)/share/ugpp
;
explicit install-share-files ;

alias
	install
:
	install-headers
	install-libs
	install-share-files
;
explicit install ;

#################################################################
# export project

alias
	ugpp
:
	./cpp//ugpp
:
:
:
	<include>$(src-inc-dir)
;

