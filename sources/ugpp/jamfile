constant name : $(name)/ugpp ;
show-build $(name) : >>>>>>>>> ;

build-project adap ;
build-project base ;

#############################################################################

lib
	ugpp
:
	./base//ugpp-base
	./adap//ugpp-adap
:
	<version>$(version)
	<tag>@make-version
:
:
	<include>./base/hpp
	<include>./adap/hpp
;

rule make-version ( name : type ? : props )
{
	import common ;
	local name = [ common.format-name <base> : $(name) : $(type) : $(props) ] ;
	local version = [ $(props).get <version> ] ;
	return $(name).$(version) ;
}

#############################################################################

alias
	install-headers
:
	./base//install-headers
	./adap//install-headers
;
explicit install-headers ;

install
	install-lib
:
	ugpp
:
	<location>$(prefix)/lib
;
explicit install-lib ;

install
	install-share
:
	../../LICENSE_1_0.txt
:
	<location>$(prefix)/share/ugpp
;
explicit install-share ;

alias
	install
:
	install-headers
	install-lib
	install-share
;
explicit install ;

